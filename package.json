{
  "name": "nextgen-landing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build --turbopack",
    "dev": "next dev --turbopack",
    "start": "next start",
    "lint": "eslint",
    "convex:dev": "convex dev",
    "convex:codegen": "convex codegen",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
